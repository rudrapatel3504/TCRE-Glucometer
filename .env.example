# =========================================================================
# TCRE GLUCOMETER SYSTEM ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and configure the variables for local development or cloud deployment.
# =========================================================================

# Node Environment (development | production)
NODE_ENV=development

# Backend Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Local JSON Database Configuration
# Relative path from backend/src
LOCAL_DB_DIR=../database/data

# Future PostgreSQL Configuration (For cloud migration)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/tcre_db?schema=public

# Frontend Server Configuration (For client references if proxy rewrites are bypassed)
NEXT_PUBLIC_API_URL=http://localhost:3000
